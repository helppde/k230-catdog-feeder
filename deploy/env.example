# /etc/catdog/env  —— 服务端环境变量
#
# 权限要收紧，里面有 token：
#   sudo chown root:catdog /etc/catdog/env
#   sudo chmod 640 /etc/catdog/env
#
# 改完要重启才生效：sudo systemctl restart catdog

# ---- 必填 ----
# 上传鉴权。不设的话任何人知道地址就能往你库里塞照片。
# 生成一串随机字符： openssl rand -hex 24
# K230 的 k230_trigger.py 里 API_TOKEN 必须和它**完全一致**。
CATDOG_TOKEN=把这里换成openssl生成的随机串

# ---- 数据目录（一定要在持久化磁盘上）----
# 数据库和照片都在这。容器/系统盘重建时会丢，所以单独放。
CATDOG_DATA_DIR=/var/lib/catdog

# ---- 监听地址 ----
# 前面有 nginx 就绑 127.0.0.1，公网只能通过 443 进来。
# 不挂反代、想直接用 IP:8000 访问时才改 0.0.0.0。
CATDOG_HOST=127.0.0.1
CATDOG_PORT=8000

# ---- 可选：让 Python 自己开 TLS ----
# 只有在**没有** nginx 反代时才用。有反代就别开，重复加密没意义。
# CATDOG_TLS_CERT=/etc/nginx/ssl/catdog.example.com.pem
# CATDOG_TLS_KEY=/etc/nginx/ssl/catdog.example.com.key
